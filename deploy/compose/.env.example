# Copy to deploy/compose/.env (git-ignored) and adjust.

# Image version to run; a git tag published by the Release workflow.
# TAG=v0.1.0

# Behind nginx: trust X-Real-IP and keep port 3000 off the network.
# TRUST_X_REAL_IP=true
# BIND=127.0.0.1

# Address the metrics port listens on, for a Prometheus on another host.
# METRICS_BIND=0.0.0.0
